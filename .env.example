# StarFlow environment variables.
# Copy to .env.local for development. In production set these in the Vercel
# project settings. NEVER commit real values.
#
# In production the server REFUSES TO START if a "required" variable is missing
# (see lib/env.ts and instrumentation.ts).

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by the Stripe webhook, cron and billing
# lookups. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App (required) ----------------------------------------------------------
# Canonical public origin, no trailing slash. Used for auth redirects, Stripe
# return URLs and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (required) -------------------------------------------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...), not the API key.
STRIPE_WEBHOOK_SECRET=
# Price id of the Pro plan (price_...). Read at build time (NEXT_PUBLIC_).
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# --- Email via Resend (required) ---------------------------------------------
RESEND_API_KEY=
# Set ONE of these. The domain must be verified in Resend for production.
#   RESEND_FROM:       full header, e.g. StarFlow Alerts <alerts@yourdomain.com>
#   RESEND_FROM_EMAIL: address only; the display name is added for you
RESEND_FROM_EMAIL=alerts@yourdomain.com
# RESEND_FROM=

# --- AI (required) -----------------------------------------------------------
# Claude, via the Vercel AI SDK. Model id lives in lib/ai/model.ts.
ANTHROPIC_API_KEY=

# --- Cron (required) ---------------------------------------------------------
# Any long random string (e.g. `openssl rand -hex 32`). When this variable is
# set on Vercel, Vercel Cron sends it as `Authorization: Bearer <value>`, and
# /api/cron/alerts rejects requests without it.
CRON_SECRET=
